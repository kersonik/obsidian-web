# Apache Configuration for Obsidian Web

# Disable directory browsing
Options -Indexes

# Default charset
AddDefaultCharset UTF-8

# Block direct access to sensitive files and directories
<FilesMatch "(^\.|\.sqlite$|\.db$|\.log$|\.json$|ip_attempts\.json$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect data, logs, and vaults folders
RedirectMatch 403 ^.*/(data|logs|vaults)/.*$
